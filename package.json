{
  "name": "ai-job-agent",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck:api": "npm run typecheck --workspace=@ai-job-agent/api",
    "start:api": "npm run build --workspace=@ai-job-agent/api && node --env-file=.env apps/api/dist/index.js",
    "eval:api": "npm run build --workspace=@ai-job-agent/api && node --env-file=.env --experimental-vm-modules node_modules/jest/bin/jest.js --config apps/api/jest.eval.config.mjs --runInBand",
    "typecheck:web": "npm run typecheck --workspace=@ai-job-agent/web",
    "dev:web": "npm run dev --workspace=@ai-job-agent/web"
  },
